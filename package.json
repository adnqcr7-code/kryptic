{
  "name": "kryptic",
  "version": "1.0.1",
  "private": true,
  "bin": { "kryptic": "src/cli.js" },
  "description": "Local-first AI coding agent CLI",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "kryptic": "node src/cli.js",
    "start": "node src/cli.js start",
    "setup": "node src/cli.js setup",
    "chat": "node src/cli.js chat",
    "test": "node --test test/**/*.test.js",
    "benchmark": "node src/benchmark-runner.js",
    "demo": "node src/cli.js demo",
    "v1:test": "node scripts/v1-check.mjs"
  }
}
